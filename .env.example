# Optional. Defaults to "zenthiccc" when unset.
GITHUB_USERNAME=zenthiccc

# Optional. Raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# Leave unset to use unauthenticated public requests. A classic token with no
# scopes is enough for public repo data.
GITHUB_TOKEN=

# Optional. Absolute site URL used for metadata (Open Graph). Defaults to a
# placeholder (https://example.com) — set this to the production domain.
SITE_URL=
